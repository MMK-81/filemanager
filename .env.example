# دامنه‌ای که به IP سرور اشاره می‌کند (بدون https و بدون /)
DOMAIN=files.example.com

# ایمیل برای دریافت اعلان‌های گواهی SSL (Let's Encrypt)
ACME_EMAIL=you@example.com

# رمز ادمین (حداقل ۱۲ کاراکتر، بدون فاصله و #)
ADMIN_PASSWORD=change-me-strong-password

# با اجرای setup.sh به‌صورت خودکار ساخته می‌شود - دست نزنید
JWT_SECRET=__GENERATE__

# اختیاری: برای فعال‌سازی 2FA (openssl rand -base64 32)
# TOTP_SECRET=
